/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.login-btn {
  background-color: #07c160;
  color: white;
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
}

.user-info__container {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.course-input {
  background-color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.course-textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.btn-group {
  display: flex;
  justify-content: space-between;
}

.btn {
  width: 48%;
  padding: 15rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.parse-btn {
  background-color: #1677ff;
  color: white;
}

.clear-btn {
  background-color: #f5f5f5;
  color: #666;
}

.course-display {
  background-color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.course-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 30rpx;
}

.table-header {
  display: flex;
  background-color: #f5f5f5;
  font-weight: bold;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #eee;
}

.table-cell {
  flex: 1;
  padding: 15rpx 10rpx;
  font-size: 24rpx;
  text-align: center;
  word-break: break-all;
}

.export-btn {
  width: 100%;
  background-color: #07c160;
  color: white;
  padding: 15rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-top: 20rpx;
}
    